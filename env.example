# software-factory environment. Copy to a private .env (never commit it) or
# export these from your secret store. Names only; no value here is real.

# PostgreSQL holding watcher, job, posting and audit state (required).
DATABASE_URL=postgresql://factory:change-me@localhost:5432/software_factory

# Forge credentials: least-privilege token per configured forge.
FORGEJO_TOKEN=
# Generic forge token read by the Actions lane scripts.
FORGE_TOKEN=
# Only if a repository in config/repos.yml uses provider: github.
GITHUB_TOKEN=

# Shared secret for signed Forgejo webhooks (POST /hooks/forgejo). When set,
# the status listener leaves loopback; leave empty for a loopback-only server.
FORGE_WEBHOOK_SECRET=

# Optional NATS event bus for runner results and side channels.
NATS_URL=nats://localhost:4222
NATS_NKEY_FILE=

# Optional Langfuse tracing.
LANGFUSE_BASE_URL=

# Optional TypeSafe (Jev) classifier key for model routing and triage advice.
TYPESAFE_API_KEY=

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Build identity shown on the status page.
SOFTWARE_FACTORY_COMMIT=

# Tests only: a writable directory for fixtures (default ~/_tmp/software-factory).
RODADDY_WATCHER_TEST_TMP=

# Optional submit-draft guard: a personal cell number drafts must never carry
# (unset turns that check off), and the contact number the refusal points to.
SUBMIT_DRAFT_BLOCKED_PHONE=
SUBMIT_DRAFT_CONTACT_PHONE=
