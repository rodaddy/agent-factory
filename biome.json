{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noConsole": { "level": "error", "options": { "allow": ["error"] } }
			},
			"style": {
				"useConst": "error",
				"noNonNullAssertion": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!drizzle",
			"!docs/images",
			"!_reports/test-runs",
			"!fleet/forge",
			"!tests/fleet/policy",
			"!tests/fixtures/pi-stream"
		]
	},
	"overrides": [
		{
			"includes": ["src/index.ts", "scripts/**"],
			"linter": {
				"rules": {
					"suspicious": { "noConsole": "off" }
				}
			}
		}
	]
}
