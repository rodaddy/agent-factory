			"fleet-pi": "canary",
			"admission": "enforce",
			"agents": [["Desai", "idle"], ["Reed", "paused"], ["Kong", "terminated"]]
		},
		"open": 3,
		"status": { "s1a": "success", "s2a": "failure", "s2b": "success" },
