#!/opt/homebrew/opt/node@24/bin/node
// forge-pr-open: open a Forge PR only when its body and diff meet the bar.
//
// Rico, 2026-10-05: sessions do not open poor PRs; a PR below the bar is
// rejected. The intake bar (paperclip-review DESIGN
// D3, plan item D1.4) is applied here, before the PR opens, so the head
// learns first. The dev-rules mod rule pr-bar denies every other way of
// opening a Forge PR from a session.
//
// Usage: forge-pr-open --repo <owner>/<repo> --head <branch> [--base main]
//          --title <t> --body-file <path> [--check-only] [--as claude|codex|pi]
// Run from the repo checkout (the diff is read from it).
//
// The bar, read with `<!-- -->` comments and empty code fences removed (a
// section holding only prompts is empty): the first line is the signature
// `**agent:** <harness> · model <id> · seat <seat> · <YYYY-MM-DD>`
// (_DOCS/GIT_STANDARDS.md); `##` sections Summary, Evidence, Merge danger,
// Backout, Test plan, each non-empty; Merge danger names `one-way door` or `two-way door` and has
// a `Blast radius:` line; Test plan holds a command (a backticked span or a
// code block); a `## Local review` section (operator ruling 2026-10-08: every PR
// is swarm-reviewed locally and arrives clean) holds one `swarm: <receipt>`
// and `open P0/P1: 0`, the receipt a file or a Forge comment holding
// `reviewed: <sha on this branch>`, two `LANE:` lines and `open P0/P1: 0`
// (checkReceipt). A Paperclip employee is refused outright (operator ruling
// 2026-10-08: employees do not open PRs); the body
// links a Forge issue (`/issues/<n>`); the diff
// origin/<base>...<head> ADDS at most 1200 lines of code and tests (Rico
// ruling 2026-10-08; was 400). Deletions never count:
// whole-file deletions, removal-only hunks and the removed lines of mixed
// hunks are all free; the removed total is printed beside the count.
// Reviewers read a big PR in slices of 400 lines or fewer. Binaries have no
// line count. Docs (DOC_FILE: .md, .mdx, .markdown, .txt, .rst, .adoc) are
// printed but not capped: the bar is for code and test changes (operator ruling
// 2026-10-07). Config (.json, .yaml, .tsv) counts as code. A
// renamed doc still counts. Generated lockfiles (LOCKFILES) are printed but not
// capped. So are vendored files: a file whose own dir
// (not an ancestor) holds a file named exactly `VENDORED` at the PR head is a
// byte-exact copy of code reviewed where it lives, e.g. software-factory's
// fleet/forge copy of Development's forge (~1,900 lines, no split fits; Rico
// 2026-10-06). The marker itself counts. So are generated files: a
// file named exactly `GENERATED` at the PR head lists, one bare name per line
// (`#` comments and blank lines skipped; a `/`, `.` or `..` is refused), files
// in its own dir that a generator there makes, e.g. the 2,368-line
// forge-swagger.min.json fixture; reviewers read the generator. The marker,
// the generator and every unlisted file count (Rico 2026-10-06,
// development#1089). A drizzle-kit migration snapshot (DRIZZLE_SNAPSHOT,
// `drizzle/meta/*_snapshot.json`, not `_journal.json`, not a rename) is generated by rule and
// needs no marker, since drizzle-kit parses every file there as JSON (Rico
// 2026-10-12). Lockfiles, vendored files, generated files and docs are
// never counted twice. Renames and copies still count. The count is printed
// either way.
//
// Exit: 0 passed (and opened, without --check-only); 1 refused, one missing
// item per stderr line; 3 usage, git, token or Forge error.
//
// Token: the session's own harness account (claude-session by default; the
// factory-pr skill and development#881: a session never posts as an
// employee), from _ob/bin/forgejo-<as>-session-token on stdout. It goes into
// a request header in this process only: never argv, never printed. A Paperclip employee (no --as,
// FORGE_LOGIN and FORGEJO_TOKEN both set; development#992) uses FORGEJO_TOKEN instead.

import { execFileSync, spawnSync } from "node:child_process";
import { readFileSync, realpathSync, statSync } from "node:fs";
import { dirname, isAbsolute, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

export const API = "https://forge.example.internal/api/v1";
export const SECTIONS = ["Summary", "Evidence", "Merge danger", "Backout", "Test plan"];
export const MAX_LINES = 1200;
const HARNESSES = new Set(["claude", "codex", "pi"]);

class Usage extends Error {}

export function parseArgs(argv) {
	const opts = { base: "main", checkOnly: false };
	const takes = { "--repo": "repo", "--head": "head", "--base": "base", "--title": "title", "--body-file": "bodyFile", "--as": "as" };
	for (let i = 0; i < argv.length; i++) {
		const a = argv[i];
		if (a === "--check-only") opts.checkOnly = true;
		else if (takes[a]) {
			if (i + 1 >= argv.length) throw new Usage(`${a} needs a value`);
			opts[takes[a]] = argv[++i];
		} else throw new Usage(`unknown argument '${a}'`);
	}
	for (const k of ["repo", "head", "title", "bodyFile"]) {
		if (!opts[k]) throw new Usage(`--${k === "bodyFile" ? "body-file" : k} is required`);
	}
	if (!/^[\w.-]+\/[\w.-]+$/.test(opts.repo) || /(^|\/)\.\.?(\/|$)/.test(opts.repo)) throw new Usage(`--repo must be <owner>/<repo>, got '${opts.repo}'`);
	if (opts.as !== undefined && !HARNESSES.has(opts.as)) throw new Usage(`--as must be claude, codex or pi, got '${opts.as}'`);
	return opts;
}

/** The body's `##` sections: lower-cased heading -> text up to the next `#`/`##` heading. */
export function sections(body) {
	const out = new Map();
	let name = null;
	let fence = false;
	for (const line of body.split(/\r?\n/)) {
		if (/^\s*(```|~~~)/.test(line)) fence = !fence;
		const h = !fence && /^(#{1,2})\s+(.*?)\s*#*\s*$/.exec(line);
		if (h) {
			name = h[1] === "##" ? h[2].toLowerCase() : null;
			if (name !== null && !out.has(name)) out.set(name, "");
			continue;
		}
		if (name !== null) out.set(name, `${out.get(name)}${line}\n`);
	}
	return out;
}

/**
 * The body without its HTML comments, as a renderer hides them. Fenced blocks and code spans
 * (any backtick run, not across a blank line) are code: a `<!--` quoted there opens nothing.
 */
export function stripComments(raw) {
	const code = [];
	const keep = (m) => `\0${code.push(m) - 1}\0`;
	return raw
		.replace(/^[ \t]*(```|~~~)[^\n]*\n[\s\S]*?^[ \t]*\1[ \t]*$/gm, keep)
		.replace(/(?<!`)(`+)(?!`)(?:(?!\n[ \t]*\n)[\s\S])*?(?<!`)\1(?!`)/g, keep)
		.replace(/<!--[\s\S]*?-->/g, "")
		.replace(/\0(\d+)\0/g, (m, i) => code[i] ?? m);
}

/**
 * Every reason the body misses the bar, one per entry; empty when it passes. `localReview: false` leaves
 * the Local review shape out: main checks it with the receipt (checkLocalReview), or skips it.
 */
export function checkBody(raw, { localReview = true } = {}) {
	const problems = [];
	const body = stripComments(raw).replace(/^[ \t]*(```|~~~)[^\n]*\n[ \t]*\1[ \t]*$/gm, "");
	const first = body.split(/\r?\n/).find((l) => l.trim()) ?? "";
	if (!/^\*\*agent:\*\* \S.* · model \S+ · seat \S.* · \d{4}-\d{2}-\d{2}\s*$/.test(first)) {
		problems.push("first line must be the signature: **agent:** <harness> · model <id> · seat <seat> · <YYYY-MM-DD>");
	}
	const got = sections(body);
	for (const s of SECTIONS) {
		const text = got.get(s.toLowerCase());
		if (text === undefined) problems.push(`missing section: ## ${s}`);
		else if (!text.trim()) problems.push(`empty section: ## ${s}`);
	}
	const danger = got.get("merge danger");
	if (danger?.trim()) {
		if (!/\b(?:one|two)-way door\b/i.test(danger)) problems.push("Merge danger does not say `one-way door` or `two-way door`");
		if (!/^\s*(?:[-*]\s*)?(?:\*\*)?Blast radius:/im.test(danger)) problems.push("Merge danger has no `Blast radius:` line");
	}
	const plan = got.get("test plan");
	if (plan?.trim() && !/```[\s\S]*?```|~~~[\s\S]*?~~~|`[^`\n]+`/.test(plan)) {
		problems.push("Test plan holds no command (no backticked span and no code block)");
	}
	if (localReview) problems.push(...localReviewShape(raw).problems);
	if (!/\/issues\/\d+\b/.test(body)) problems.push("no link to a Forge issue (`/issues/<n>`): the ticket");
	return problems;
}

const BEFORE_PUSH = "see the factory-pr skill, \"Before the push\"";
/** A receipt that is still a prompt: `<...>`, TBD, n/a, none and the like. */
const PLACEHOLDER = /^(?:<.*>|tbd|todo|n\/?a|none|pending|-+|\.\.\.|…)$/i;
const FENCED = /^[ \t]*(```|~~~)[^\n]*\n[\s\S]*?^[ \t]*\1[ \t]*$/gm;
/** A `label:` line, optionally a list item, the label optionally in `**`/`__`; group 1 is the value. */
const labelLine = (name) => new RegExp(`^[ \\t]*(?:[-*][ \\t]*)?(?:\\*\\*|__)?${name}(?:\\*\\*|__)?:(?:\\*\\*|__)?[ \\t]*(.*)$`, "gim");
const valueOf = (m) => m[1].trim().replace(/(?:\*\*|__)$/, "").trim();
/** The one receipt URL form: a Forge issue or PR comment. */
export const COMMENT_URL = /^https:\/\/forge\.example\.internal\/([\w.-]+\/[\w.-]+)\/(?:pulls|issues)\/\d+#issuecomment-(\d+)$/;

/**
 * The `## Local review` shape, read with comments and fenced blocks removed:
 * the section holds one `swarm: <receipt>` (a receipt file path or a Forge comment URL) and
 * `open P0/P1: 0`; the body holds no second `swarm:` or `open P0/P1:` line. `receipt` is set only
 * when the shape passes; checkReceipt then reads it.
 */
export function localReviewShape(raw) {
	const body = stripComments(raw).replace(FENCED, "");
	const text = sections(body).get("local review");
	if (text === undefined) return { problems: [`missing section: ## Local review: run the local swarm review first, ${BEFORE_PUSH}`] };
	if (!text.trim()) return { problems: [`empty section: ## Local review: run the local swarm review first, ${BEFORE_PUSH}`] };
	const problems = [];
	const swarms = [...body.matchAll(labelLine("swarm"))];
	const opens = [...body.matchAll(labelLine("open P0/P1"))];
	if (swarms.length > 1) problems.push(`the body has ${swarms.length} \`swarm:\` lines; keep one, in ## Local review: ${BEFORE_PUSH}`);
	if (opens.length > 1) problems.push(`the body has ${opens.length} \`open P0/P1:\` lines; keep one, in ## Local review: ${BEFORE_PUSH}`);
	const swarm = labelLine("swarm").exec(text);
	const receipt = swarm ? valueOf(swarm).replace(/^`(.*)`$/, "$1").trim() : "";
	if (!swarm) problems.push(`Local review has no \`swarm: <receipt>\` line (the local swarm review's receipt file or comment URL): ${BEFORE_PUSH}`);
	else if (!receipt || PLACEHOLDER.test(receipt)) problems.push(`Local review swarm receipt '${receipt}' is not a receipt file path or comment URL: ${BEFORE_PUSH}`);
	else if (/^https?:/i.test(receipt) && !COMMENT_URL.test(receipt)) {
		problems.push(`Local review swarm receipt '${receipt}' is not a comment URL (https://forge.example.internal/<owner>/<repo>/(pulls|issues)/<n>#issuecomment-<id>): ${BEFORE_PUSH}`);
	}
	if (!labelLine("open P0/P1").test(text)) problems.push(`Local review has no \`open P0/P1: 0\` line: ${BEFORE_PUSH}`);
	for (const v of opens.map(valueOf).filter((v) => v !== "0")) {
		problems.push(`Local review says open P0/P1: '${v}': fix every P0/P1 the local swarm found before opening the PR, ${BEFORE_PUSH}`);
	}
	return { problems, receipt: problems.length ? undefined : receipt };
}

/** The commit sha `rev` names in `cwd`, or undefined. */
const commitOf = (rev, cwd) => {
	if (!rev) return undefined;
	const g = spawnSync("git", ["rev-parse", "--verify", "-q", `${rev}^{commit}`], { cwd, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
	return g.status === 0 ? g.stdout.trim() : undefined;
};
const isAncestor = (a, b, cwd) => !!a && !!b && spawnSync("git", ["merge-base", "--is-ancestor", a, b], { cwd, stdio: "ignore" }).status === 0;

/**
 * The receipt's problems: it is a non-empty file (absolute, or relative to the checkout's repo root) or
 * a Forge comment `readComment(repo, id)` returns, holding `reviewed: <sha>` on this branch (an ancestor
 * of `head`, not of `base`), at least two distinct `LANE:` lines and `open P0/P1: 0`. With `fixed: <sha>`,
 * that sha is the head; with none, `reviewed:` is the head (a stale receipt is refused).
 */
export async function checkReceipt(receipt, { cwd, head, base, readComment }) {
	const say = (why) => `swarm receipt ${receipt}: ${why}: ${BEFORE_PUSH}`;
	let text;
	const url = COMMENT_URL.exec(receipt);
	if (url) {
		try {
			text = await readComment(url[1], url[2]);
		} catch (err) {
			return [say(`the comment cannot be read (${String(err?.message ?? "error").split("\n")[0]})`)];
		}
	} else {
		const top = spawnSync("git", ["rev-parse", "--show-toplevel"], { cwd, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
		const file = isAbsolute(receipt) ? receipt : join(top.status === 0 ? top.stdout.trim() : cwd, receipt);
		if (!statSync(file, { throwIfNoEntry: false })?.isFile()) return [say("no such file")];
		text = readFileSync(file, "utf8");
	}
	if (typeof text !== "string" || !text.trim()) return [say("the receipt is empty")];
	const lines = text.split(/\r?\n/).map((l) => l.trim());
	const problems = [];
	const reviewed = lines.map((l) => /^reviewed:\s*([0-9a-f]{7,40})\b/i.exec(l)?.[1]).find(Boolean);
	if (!reviewed) problems.push("no `reviewed: <sha>` line (the head the swarm reviewed)");
	const inBranch = !!reviewed && isAncestor(reviewed, head, cwd) && !(base && isAncestor(reviewed, base, cwd));
	if (reviewed && !inBranch) {
		problems.push(`reviewed sha ${reviewed} is not in this branch (an ancestor of ${head}, not of ${base})`);
	}
	// The receipt is pinned to the head: `fixed:` names it, or with no `fixed:` line `reviewed:` does.
	const fixed = lines.map((l) => /^fixed:\s*([0-9a-f]{7,40})\b/i.exec(l)?.[1]).find(Boolean);
	const headSha = commitOf(head, cwd);
	if (fixed && commitOf(fixed, cwd) !== headSha) problems.push(`fixed sha ${fixed} is stale: it is not the PR head ${head}`);
	else if (!fixed && inBranch && commitOf(reviewed, cwd) !== headSha) {
		problems.push(`reviewed sha ${reviewed} is stale: it is not the PR head ${head} and there is no \`fixed: <sha>\` line for the head`);
	}
	const lanes = new Set(lines.filter((l) => l.startsWith("LANE:"))).size;
	if (lanes < 2) problems.push(`${lanes} \`LANE:\` lines, fewer than 2 (one per swarm lane)`);
	const open = lines.map((l) => /^open P0\/P1:\s*(.*)$/i.exec(l)?.[1].trim()).filter((v) => v !== undefined);
	if (!open.length) problems.push("no `open P0/P1: 0` line");
	else if (open.some((v) => v !== "0")) problems.push(`open P0/P1 is not 0 ('${open.find((v) => v !== "0")}')`);
	return problems.map(say);
}

/** The Local review section's shape, then its receipt: every problem, or none. */
export async function checkLocalReview(raw, ctx) {
	const { problems, receipt } = localReviewShape(raw);
	return receipt === undefined ? problems : checkReceipt(receipt, ctx);
}

/** Generated dependency lockfiles, by file name: counted and printed, never capped. */
export const LOCKFILES = new Set(["package-lock.json", "npm-shrinkwrap.json", "bun.lock", "bun.lockb", "yarn.lock", "pnpm-lock.yaml", "uv.lock", "poetry.lock", "Cargo.lock", "go.sum", "Gemfile.lock", "composer.lock", "Package.resolved"]);

/** drizzle-kit migration snapshots, by path: generated by rule, no GENERATED marker. */
export const DRIZZLE_SNAPSHOT = /(^|\/)drizzle\/meta\/[^/]+_snapshot\.json$/;

/** Documentation files, by extension: counted and printed, never capped; the bar is for code and tests. */
export const DOC_FILE = /\.(md|mdx|markdown|txt|rst|adoc)$/i;

/** The marker file naming its own dir a byte-exact vendored copy. */
export const VENDORED = "VENDORED";

const dirOf = (path) => (path.includes("/") ? path.slice(0, path.lastIndexOf("/")) : "");

/** Dirs ("" for the root) holding a file named exactly VENDORED, from `git ls-tree -r --name-only -z` (or newline) output. */
export function markerDirs(lsTree) {
	return new Set(lsTree.split(/[\0\n]/).filter((p) => p.split("/").pop() === VENDORED).map(dirOf));
}

/** The marker file listing generated files in its own dir, one bare name per line. */
export const GENERATED = "GENERATED";

/**
 * The files a GENERATED marker at repo path `marker` lists: each trimmed line, not empty and not a `#`
 * comment, is one bare file name in the marker's own dir. `paths` are repo paths; `bad` holds one
 * refusal per line breaking the bare-name rule (a `/`, or `.`/`..`).
 */
export function parseGenerated(marker, text) {
	const dir = dirOf(marker);
	const paths = [];
	const bad = [];
	for (const raw of text.split(/\r?\n/)) {
		const l = raw.trim();
		if (!l || l.startsWith("#")) continue;
		if (l.includes("/") || l === "." || l === "..") bad.push(`GENERATED marker ${marker}: line '${l}' is not a bare file name in its own dir`);
		else paths.push(dir ? `${dir}/${l}` : l);
	}
	return { paths, bad };
}

/**
 * Generated files at the head, from `git ls-tree -r --name-only -z` output and `read(markerPath)` (its text
 * at the head): {generated: Set of repo paths, bad: refusals}. A listed name with no file at the head is ignored.
 */
export function generatedPaths(lsTree, read) {
	const files = lsTree.split(lsTree.includes("\0") ? "\0" : "\n").filter(Boolean);
	const have = new Set(files);
	const generated = new Set();
	const bad = [];
	for (const marker of files.filter((p) => p.split("/").pop() === GENERATED)) {
		const r = parseGenerated(marker, read(marker));
		bad.push(...r.bad);
		for (const p of r.paths) if (have.has(p)) generated.add(p);
	}
	return { generated, bad };
}

/**
 * `git diff --numstat -z` rows as {path, added, removed, lines, lock, vendor, generated, doc}: binaries read `-` and
 * add 0; `lines` is added + removed. Paths are unquoted; a rename has an empty path field followed by its old
 * and new path as their own fields, and is judged by its new name. `vendor` is the file's own dir when that
 * dir is in `vendored` (never an ancestor; the marker itself is not vendored), else null. `generated` is true
 * for a path in `generated` (a GENERATED marker lists it) or matching DRIZZLE_SNAPSHOT that is not a lockfile,
 * vendored or the marker.
 */
export function numstatRows(numstat, vendored = new Set(), generated = new Set()) {
	const rows = [];
	const fields = numstat.split("\0");
	for (let i = 0; i < fields.length; i++) {
		// `s`: a path may hold a newline; NUL is the only record separator.
		const m = /^(\d+|-)\t(\d+|-)\t(.*)$/s.exec(fields[i]);
		if (!m) continue;
		let path = m[3];
		const renamed = path === "";
		if (renamed) {
			path = fields[i + 2] ?? "";
			i += 2;
		}
		const name = path.split("/").pop();
		const lock = LOCKFILES.has(name);
		const vendor = !lock && name !== VENDORED && vendored.has(dirOf(path)) ? dirOf(path) : null;
		const added = m[1] === "-" ? 0 : Number(m[1]);
		const removed = m[2] === "-" ? 0 : Number(m[2]);
		const gen = !lock && vendor === null && name !== GENERATED && (generated.has(path) || (!renamed && DRIZZLE_SNAPSHOT.test(path)));
		const doc = !lock && vendor === null && !gen && !renamed && DOC_FILE.test(name);
		rows.push({ path, added, removed, lines: added + removed, lock, vendor, generated: gen, doc });
	}
	return rows;
}

const capped = (r) => !(r.lock || r.vendor !== null || r.generated || r.doc);

/**
 * The bar's count: lines ADDED in code and tests, from `git diff --numstat -z` output. Generated lockfiles,
 * vendored files, generated files and docs are left out; removed lines never count.
 */
export function countAddedLines(numstat, vendored = new Set(), generated = new Set()) {
	return numstatRows(numstat, vendored, generated).reduce((n, r) => (capped(r) ? n + r.added : n), 0);
}

/** Lines removed from code and tests, printed beside the count, never counted. */
export function removedLines(numstat, vendored = new Set(), generated = new Set()) {
	return numstatRows(numstat, vendored, generated).reduce((n, r) => (capped(r) ? n + r.removed : n), 0);
}

/** Lines changed in docs (DOC_FILE), printed beside the count but not capped. */
export function docLines(numstat, vendored = new Set(), generated = new Set()) {
	return numstatRows(numstat, vendored, generated).reduce((n, r) => (r.doc ? n + r.lines : n), 0);
}

/** How many docs the printed doc lines come from. */
export function docFiles(numstat, vendored = new Set(), generated = new Set()) {
	return numstatRows(numstat, vendored, generated).filter((r) => r.doc).length;
}

/** Lines changed in generated lockfiles, printed beside the count but not capped. */
export function lockfileLines(numstat) {
	return numstatRows(numstat).reduce((n, r) => (r.lock ? n + r.lines : n), 0);
}

/** Lines changed in vendored files (own dir in `vendored`), printed beside the count but not capped. */
export function vendoredLines(numstat, vendored) {
	return numstatRows(numstat, vendored).reduce((n, r) => (r.vendor !== null ? n + r.lines : n), 0);
}

/** The vendored dirs the diff touches, sorted, for the printed line. */
export function vendoredDirs(numstat, vendored) {
	return [...new Set(numstatRows(numstat, vendored).filter((r) => r.vendor !== null).map((r) => r.vendor || "."))].sort();
}

/** Lines changed in generated files (listed in a GENERATED marker), printed beside the count but not capped. */
export function generatedLines(numstat, generated, vendored = new Set()) {
	return numstatRows(numstat, vendored, generated).reduce((n, r) => (r.generated ? n + r.lines : n), 0);
}

/** The generated files the diff touches, as repo paths, sorted, for the printed line. */
export function generatedFiles(numstat, generated, vendored = new Set()) {
	return numstatRows(numstat, vendored, generated).filter((r) => r.generated).map((r) => r.path).sort();
}

function git(args, cwd) {
	try {
		return execFileSync("git", args, { cwd, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], maxBuffer: 64 * 1024 * 1024 });
	} catch (err) {
		throw new Error(`git ${args.join(" ")}: ${String(err?.stderr ?? "").trim().split("\n")[0] || `exit ${err?.status ?? "unknown"}`}`);
	}
}

/** No --as with FORGE_LOGIN and FORGEJO_TOKEN set: the employee's token; else the harness script (claude by default). */
export function token(flag, env = process.env) {
	if (flag === undefined && env.FORGE_LOGIN && env.FORGEJO_TOKEN) return env.FORGEJO_TOKEN;
	const as = flag ?? "claude";
	const script = join(dirname(realpathSync(fileURLToPath(import.meta.url))), `forgejo-${as}-session-token`);
	let out;
	try {
		out = execFileSync(script, [], { encoding: "utf8", timeout: 60_000, stdio: ["ignore", "pipe", "pipe"] });
	} catch (err) {
		throw new Error(`forgejo-${as}-session-token exit ${err?.status ?? err?.code ?? "unknown"}`);
	}
	const t = out.trim();
	if (!t) throw new Error(`forgejo-${as}-session-token printed nothing`);
	return t;
}

async function openPr(opts, body, env) {
	const tok = token(opts.as, env);
	let res;
	try {
		res = await fetch(`${API}/repos/${opts.repo}/pulls`, {
			method: "POST",
			headers: { authorization: `token ${tok}`, "content-type": "application/json", accept: "application/json" },
			body: JSON.stringify({ title: opts.title, head: opts.head, base: opts.base, body }),
			signal: AbortSignal.timeout(30_000),
		});
	} catch (err) {
		throw new Error(`POST pulls: ${err?.cause?.code ?? err?.name ?? "network error"}`);
	}
	let json = null;
	try {
		json = await res.json();
	} catch {
		// A non-JSON error page has nothing worth reading.
	}
	if (res.status !== 201 || !json?.html_url) {
		throw new Error(`POST pulls: HTTP ${res.status}${json?.message ? ` -- ${String(json.message).split(tok).join("***")}` : ""}`);
	}
	return json.html_url;
}

const HERE = dirname(realpathSync(fileURLToPath(import.meta.url)));

/** A comment's body, read by forge's own `comment view` (its client, token and redirect handling). */
const forgeComment = (as, deps) => async (repo, id) => {
	const { main: forge } = await import(pathToFileURL(join(HERE, "forge")).href);
	const out = [];
	const err = [];
	const code = await forge(["--as", as ?? "claude", "--json", "comment", "view", repo, id],
		{ fetch: deps.fetch, token: deps.token, stdout: (l) => out.push(l), stderr: (l) => err.push(l) });
	if (code !== 0) throw new Error(err.join(" ") || `forge exit ${code}`);
	return JSON.parse(out.join("\n"))?.body;
};

/** `deps` (tests): env, and fetch/token for the receipt comment read. */
export async function main(argv = process.argv.slice(2), cwd = process.cwd(), deps = {}) {
	const env = deps.env ?? process.env;
	let opts;
	try {
		opts = parseArgs(argv);
	} catch (err) {
		console.error(`forge-pr-open: ${err.message}`);
		console.error("usage: forge-pr-open --repo <owner>/<repo> --head <branch> [--base main] --title <t> --body-file <path> [--check-only] [--as claude|codex|pi]");
		return 3;
	}
	// A Paperclip employee (no --as, FORGE_LOGIN and FORGEJO_TOKEN set) does not open PRs (operator ruling
	// 2026-10-08). Sessions always pass --as through `forge pr create`.
	if (opts.as === undefined && env.FORGE_LOGIN && env.FORGEJO_TOKEN) {
		console.error("forge-pr-open: refused: Paperclip employees do not open PRs (operator ruling 2026-10-08)");
		return 1;
	}
	try {
		const body = readFileSync(opts.bodyFile, "utf8");
		const problems = checkBody(body, { localReview: false });
		const readComment = deps.readComment ?? forgeComment(opts.as, deps);
		problems.push(...await checkLocalReview(body, { cwd, head: opts.head, base: `origin/${opts.base}`, readComment }));
		const numstat = git(["diff", "--numstat", "-z", `origin/${opts.base}...${opts.head}`], cwd);
		const tree = git(["ls-tree", "-r", "--name-only", "-z", opts.head], cwd);
		const vendored = markerDirs(tree);
		const gp = generatedPaths(tree, (p) => git(["show", `${opts.head}:${p}`], cwd));
		problems.push(...gp.bad);
		const generated = gp.generated;
		const lines = countAddedLines(numstat, vendored, generated);
		const removed = removedLines(numstat, vendored, generated);
		const lock = lockfileLines(numstat);
		const vend = vendoredLines(numstat, vendored);
		const gen = generatedLines(numstat, generated, vendored);
		const doc = docLines(numstat, vendored, generated);
		const extra = [doc ? `${doc} doc lines (${docFiles(numstat, vendored, generated)} files)` : "",
			lock ? `${lock} lockfile lines` : "", vend ? `${vend} vendored lines (${vendoredDirs(numstat, vendored).join(", ")})` : "",
			gen ? `${gen} generated lines (${generatedFiles(numstat, generated, vendored).join(", ")})` : ""].filter(Boolean);
		console.log(`forge-pr-open: ${lines} added lines of code and tests (bar ${MAX_LINES}; ${removed} removed, never counted)${extra.length ? `; plus ${extra.join(", ")}, not capped` : ""}`);
		if (lines > MAX_LINES) problems.push(`diff adds ${lines} lines of code and tests, over ${MAX_LINES}: split it into separate or stacked PRs`);
		if (problems.length) {
			for (const p of problems) console.error(`forge-pr-open: ${p}`);
			return 1;
		}
		if (opts.checkOnly) {
			console.log("forge-pr-open: the bar passes (--check-only, nothing opened)");
			return 0;
		}
		console.log(await openPr(opts, body, env));
		return 0;
	} catch (err) {
		console.error(`forge-pr-open: ${err?.message ?? "unknown error"}`);
		return 3;
	}
}

const invoked = process.argv[1] ? realpathSync(process.argv[1]) : "";
if (invoked === realpathSync(fileURLToPath(import.meta.url))) {
	process.exitCode = await main();
}
