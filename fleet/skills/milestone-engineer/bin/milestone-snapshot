#!/usr/bin/env python3
"""Snapshot a Forge repo's milestones, open issues, and blocking (sf#1186).

usage: milestone-snapshot <owner/repo>
env: FORGEJO_API_URL (e.g. https://forge.example.internal/api/v1), FORGEJO_TOKEN.
The token travels only in the Authorization header. Read-only: GET only.
stdout: the JSON wayfinder-render takes; issues with no milestone go under
"unassigned".
"""
import json
import os
import re
import sys
import urllib.error
import urllib.request


def get(api, token, path):
    req = urllib.request.Request(api + path, headers={"Authorization": f"token {token}", "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)


def pages(api, token, path):
    sep = "&" if "?" in path else "?"
    page, items = 1, []
    while True:
        batch = get(api, token, f"{path}{sep}limit=50&page={page}")
        if not batch:
            return items
        items += batch
        page += 1


def main():
    if len(sys.argv) != 2 or not re.fullmatch(r"[\w.-]+/[\w.-]+", sys.argv[1]):
        sys.exit("usage: milestone-snapshot <owner/repo>")
    repo = sys.argv[1]
    api = os.environ.get("FORGEJO_API_URL", "").rstrip("/")
    token = os.environ.get("FORGEJO_TOKEN", "")
    if not api or not token:
        sys.exit("milestone-snapshot: FORGEJO_API_URL and FORGEJO_TOKEN are required")
    base = f"/repos/{repo}"
    milestones = pages(api, token, f"{base}/milestones?state=all")
    issues = pages(api, token, f"{base}/issues?state=open&type=issues")
    deps_ok = True
    by_ms = {m["id"]: [] for m in milestones}
    unassigned = []
    for i in issues:
        blocked = []
        if deps_ok:
            try:
                blocked = sorted(
                    int(d["number"]) for d in get(api, token, f"{base}/issues/{i['number']}/dependencies")
                    if (d.get("repository") or {}).get("full_name", repo) == repo
                )
            except urllib.error.HTTPError as e:
                if e.code in (404, 405, 501):
                    deps_ok = False
                else:
                    raise
        entry = {"number": i["number"], "title": i["title"], "state": i["state"], "blockedBy": blocked}
        ms = i.get("milestone")
        (by_ms.setdefault(ms["id"], []) if ms else unassigned).append(entry)
    out = {
        "repo": repo,
        "milestones": [
            {"id": m["id"], "title": m["title"], "goal": m.get("description") or "", "doneWhen": "",
             "state": m.get("state"), "issues": sorted(by_ms.get(m["id"], []), key=lambda x: x["number"])}
            for m in sorted(milestones, key=lambda m: m["id"])
        ],
        "unassigned": sorted(unassigned, key=lambda x: x["number"]),
        "dependenciesAvailable": deps_ok,
    }
    json.dump(out, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
