#!/usr/bin/env python3
"""delta-check (sf#1395): did a new PR head only merge main into an approved head?

Usage: delta-check <repo-dir> <approved-sha> <head-sha>

Run inside the task worktree (cwd) after `git fetch origin`, so both commits and
origin/main are present.

Output: one JSON object on stdout.
  {"kind": "not-a-main-merge", "files": [], "reason": "..."}
     the head is not a two-parent merge whose first parent is <approved-sha>
     and whose second parent is on origin/main (an ancestor of it, or equal);
     the reason names the condition that failed. Review normally.
  {"kind": "clean", "files": [], "approved": "<approved-sha>", "verdict": "approve"}
     `git merge-tree --write-tree <approved> <p2>` merges without conflict and
     its tree is exactly the head's tree: nothing to review. verdict is the
     word the delta round posts: always `approve`, also when the previous
     round was `approve-with-fixes`. A delta round is round 2 or later, and
     the stop rule gives round 2+ with no P0/P1 `approve`; the previous
     round's P2s become follow-ups.
  {"kind": "resolved", "files": [sorted paths], "approved": "<approved-sha>"}
     the merge conflicted, or the head's tree differs from the clean merge (an
     evil merge). files = the conflicted paths plus every path where the head's
     tree differs from the merge-tree result: review only those.

Exit: 0 when the JSON is printed; 1 on usage; 2 when a git command fails
  (stderr names the git command, never file contents).
"""
import json
import subprocess
import sys


class GitError(Exception):
    pass


def git(repo, *args, ok=(0,)):
    """Run git with an argument list; return (exit code, stdout bytes)."""
    try:
        p = subprocess.run(["git", "-C", repo, *args], capture_output=True)
    except OSError as e:
        raise GitError(f"git {args[0]}: {e.strerror}") from e
    if p.returncode not in ok:
        raise GitError(f"git {' '.join(args)} exited {p.returncode}")
    return p.returncode, p.stdout


def commit(repo, rev):
    return git(repo, "rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}")[1].decode().strip()


def paths(out):
    return {p for p in out.decode().split("\0") if p}


def check(repo, approved, head):
    approved = commit(repo, approved)
    head = commit(repo, head)
    parents = git(repo, "rev-list", "--parents", "-n", "1", head)[1].decode().split()[1:]
    if len(parents) != 2:
        return {"kind": "not-a-main-merge", "files": [],
                "reason": f"head has {len(parents)} parent(s), not 2"}
    p1, p2 = parents
    if p1 != approved:
        return {"kind": "not-a-main-merge", "files": [],
                "reason": f"head's first parent {p1[:7]} is not the approved head {approved[:7]}"}
    main = commit(repo, "origin/main")
    code, _ = git(repo, "merge-base", "--is-ancestor", p2, main, ok=(0, 1))
    if code != 0:
        return {"kind": "not-a-main-merge", "files": [],
                "reason": f"head's second parent {p2[:7]} is not on origin/main"}
    # -z: tree OID, then (on conflict) one NUL-terminated name per conflicted
    # stage, then an empty field. Exit 1 means conflicts, anything else >1 fails.
    code, out = git(repo, "merge-tree", "--write-tree", "--name-only", "--no-messages", "-z",
                    approved, p2, ok=(0, 1))
    fields = out.decode().split("\0")
    tree = fields[0]
    conflicted = {f for f in fields[1:] if f}
    head_tree = git(repo, "rev-parse", "--verify", f"{head}^{{tree}}")[1].decode().strip()
    if code == 0 and tree == head_tree:
        return {"kind": "clean", "files": [], "approved": approved, "verdict": "approve"}
    differ = paths(git(repo, "diff", "--name-only", "--no-renames", "-z", tree, head_tree)[1])
    return {"kind": "resolved", "files": sorted(conflicted | differ), "approved": approved}


def main(argv):
    if len(argv) != 4:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 1
    try:
        result = check(argv[1], argv[2], argv[3])
    except GitError as e:
        print(f"delta-check: {e}", file=sys.stderr)
        return 2
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
