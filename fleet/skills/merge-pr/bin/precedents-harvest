#!/usr/bin/env python3
"""precedents-harvest: print merge-check's override precedents as merge-go examples.

Usage: precedents-harvest

Env: FLEET_STATE_DIR (default ~/.local/state/fleet), read for
  merge-go-precedents.jsonl, which merge-check appends to on every override
  (Rico, 2026-10-06). Output: one JSON object per line, {fields, expect: "yes"},
  for a person to fold into fleet/skills/merge-pr/merge-go.json `examples`.
  Nothing is written.
"""
import json
import os
import sys


def main():
    base = os.environ.get("FLEET_STATE_DIR") or os.path.expanduser("~/.local/state/fleet")
    try:
        with open(os.path.join(base, "merge-go-precedents.jsonl")) as f:
            lines = [ln for ln in f if ln.strip()]
    except OSError:
        return
    for ln in lines:
        try:
            r = json.loads(ln)
        except ValueError:
            sys.stderr.write("precedents-harvest: skipped an unreadable line\n")
            continue
        paths = "\n".join(f"{p.get('path')} +{p.get('add', '?')} -{p.get('del', '?')}" for p in r.get("paths") or [])
        fields = {"repo": str(r.get("repo")), "title": str(r.get("title")), "paths": paths,
                  "kickback": str(r.get("kickback"))}
        print(json.dumps({"fields": fields, "expect": "yes"}))


if __name__ == "__main__":
    main()
