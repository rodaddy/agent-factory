#!/usr/bin/env bash
# Print the Forgejo API token on stdout, nothing else.
#
# The original deployment fetched this from a password manager on every call.
# This public stub reads it from the environment instead; replace it with your
# own secret-store lookup if you have one. Fail loud, never print a default.
set -euo pipefail
if [[ -z "${FORGEJO_TOKEN:-}" ]]; then
	echo "forgejo-token: FORGEJO_TOKEN is not set" >&2
	exit 1
fi
printf '%s\n' "$FORGEJO_TOKEN"
